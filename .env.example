# Example only. Never replace existing Render secrets with this file.
# Testing must use a separate data directory, no production credentials/subscription.
PORT=10000
WTI_DATA_DIR=/var/data/wti-test
WTI_MONITOR_ENABLED=false
WTI_MONITOR_SECRET=
# Optional single-owner sign-in. Configure a long, random value in Render only.
WTI_ACCESS_TOKEN=
IG_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_EPIC=
# Preserves the app's existing cents-to-dollars conversion. Verify with IG first.
IG_PRICE_DIVISOR=100
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
